# Copy to a project's .env and supply that project's own credentials.
DATABASE_URL=postgresql://localhost/my_project

# Alternatively, use named URLs or an array on a single line.
# DB_URLS='{"local":"postgresql://localhost/my_project","tests":"postgresql://localhost/my_project_test"}'
# DB_URLS='["postgresql://localhost/my_project","postgresql://localhost/my_project_test"]'
