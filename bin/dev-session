#!/usr/bin/env python3
"""Create or enter a tmux workspace for a project directory."""
import hashlib
import os
from pathlib import Path
import re
import subprocess
import sys

if len(sys.argv) > 2:
    sys.exit("Usage: dev-session [PROJECT_DIRECTORY]")
project = Path(sys.argv[1] if len(sys.argv) == 2 else ".").expanduser().resolve()
if not project.is_dir():
    sys.exit(f"Not a directory: {project}")
name = re.sub(r"[^a-zA-Z0-9_-]", "-", project.name or "root")
name += "-" + hashlib.sha256(str(project).encode()).hexdigest()[:8]
if os.environ.get("TMUX"):
    existing = subprocess.run(["tmux", "has-session", "-t", "=" + name], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    if existing.returncode:
        subprocess.run(["tmux", "new-session", "-d", "-s", name, "-c", str(project)], check=True)
    command = ["tmux", "switch-client", "-t", "=" + name]
else:
    command = ["tmux", "new-session", "-A", "-s", name, "-c", str(project)]
os.execvp(command[0], command)
